@{
    ViewData["Title"] = "RaceDay - Home";
}

<style>
    .raceday-hero {
        background: linear-gradient(135deg, #142d4e, #245b79);
        color: white;
        padding: 65px 35px;
        border-radius: 16px;
        margin-top: 25px;
    }

        .raceday-hero h1 {
            font-size: 42px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .raceday-hero p {
            font-size: 18px;
            line-height: 1.7;
            max-width: 650px;
        }

    .raceday-section {
        padding: 45px 10px;
    }

    .raceday-card {
        background: #f5f7fa;
        border-radius: 12px;
        padding: 25px;
        height: 100%;
        border: 1px solid #e5e9ef;
    }

        .raceday-card h4 {
            color: #183b59;
            font-weight: 700;
        }

    .raceday-button {
        display: inline-block;
        background: #f2a900;
        color: #142d4e;
        padding: 12px 25px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 700;
        margin-top: 15px;
    }
</style>

<div class="raceday-hero">
    <h1>Welcome to RaceDay</h1>

    <p>
        Your journey to every finish line starts here.
        Discover sporting events, explore upcoming races,
        manage your entries and keep track of your results
        all in one place.
    </p>

    <a href="#features" class="raceday-button">
        Explore RaceDay
    </a>
</div>

<div class="raceday-section" id="features">
    <div class="text-center mb-4">
        <h2>Everything You Need for RaceDay</h2>
        <p class="text-muted">
            Your sporting journey, organised in one place.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="raceday-card">
                <h4>Discover Events</h4>
                <p>
                    Browse sporting events and find races
                    that match your interests.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="raceday-card">
                <h4>Manage Entries</h4>
                <p>
                    Keep track of your event enrolments
                    and participation.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="raceday-card">
                <h4>Track Results</h4>
                <p>
                    View your event results and follow
                    your sporting progress.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="text-center mb-5">
    <h2>Ready for Your Next Challenge?</h2>
    <p class="text-muted">
        Make every race count with RaceDay.
    </p>
</div>

