@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5" style="max-width: 900px;">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Privacy Policy</h1>
        <p class="text-muted">Your privacy matters to us at RaceDay.</p>
    </div>

    <section class="mb-4">
        <h3>1. Introduction</h3>
        <p>
            Welcome to RaceDay. We are committed to respecting your
            privacy and protecting the personal information you provide
            when using our website.
        </p>
    </section>

    <section class="mb-4">
        <h3>2. Information We Collect</h3>
        <p>
            RaceDay may collect information such as your name, email
            address and account details when you register or use
            the website.
        </p>
    </section>

    <section class="mb-4">
        <h3>3. How We Use Your Information</h3>
        <p>
            Your information may be used to manage your account,
            support event entries and improve your experience
            on the RaceDay platform.
        </p>
    </section>

    <section class="mb-4">
        <h3>4. Information Security</h3>
        <p>
            We aim to protect user information and prevent
            unauthorised access, disclosure or misuse.
        </p>
    </section>

    <section class="mb-4">
        <h3>5. Contact Us</h3>
        <p>
            If you have questions about this Privacy Policy,
            please contact the RaceDay website administrator.
        </p>
    </section>

    <div class="text-muted mt-5">
        <small>Last updated: November 2026</small>
    </div>

</div>
